default_platform(:ios)

# Lane code runs with cwd = this file's own directory (tools/fastlane), not
# tools/ and not the repo root - every path below is built from this
# constant rather than a relative "../..." that would resolve against the
# wrong directory.
REPO_ROOT = File.expand_path("../..", __dir__)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT_BASE64"),
      is_key_content_base64: true
    )
  end

  desc "Local, read-write: create/fetch the App Store distribution cert + profiles for both bundle IDs"
  lane :bootstrap do
    match(type: "appstore", readonly: false)
  end

  desc "CI, read-only: fetch existing signing material, build both flavors, upload both to TestFlight"
  lane :ci_release do
    match(type: "appstore", readonly: true)

    ipa_dir = File.join(REPO_ROOT, "build", "ios", "ipa")
    # A monotonically increasing build number per CI run. Falls back to a
    # timestamp for a local/manual run where GITHUB_RUN_NUMBER isn't set -
    # TestFlight only requires each app's own build numbers to increase, not
    # that the two flavors' numbers relate to each other.
    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s

    {
      "user" => {
        bundle_id: "com.rajendrakhope.sevarath",
        target: "lib/main_user.dart",
        export_options: File.join(REPO_ROOT, "ios", "ExportOptions-user.plist"),
        profile_name: "match AppStore com.rajendrakhope.sevarath"
      },
      "driver" => {
        bundle_id: "com.rajendrakhope.sevarath.driver",
        target: "lib/main_driver.dart",
        export_options: File.join(REPO_ROOT, "ios", "ExportOptions-driver.plist"),
        profile_name: "match AppStore com.rajendrakhope.sevarath.driver"
      }
    }.each do |flavor, cfg|
      FileUtils.rm_rf(ipa_dir)

      # Scoped to the Runner target only (and just this flavor's Release
      # configuration) - a blanket FLUTTER_XCODE_* override applies to every
      # target xcodebuild touches, including the Swift Package Manager
      # library targets (AppAuth, GTMAppAuth, ...), which don't support
      # provisioning profiles at all and fail the build if one is forced on
      # them. update_code_signing_settings edits only the named target.
      update_code_signing_settings(
        path: File.join(REPO_ROOT, "ios", "Runner.xcodeproj"),
        targets: ["Runner"],
        build_configurations: ["Release-#{flavor}"],
        use_automatic_signing: false,
        team_id: "3KA57X722P",
        code_sign_identity: "Apple Distribution",
        profile_name: cfg[:profile_name]
      )

      Dir.chdir(REPO_ROOT) do
        sh(
          "flutter", "build", "ipa",
          "--release",
          "--flavor", flavor,
          "-t", cfg[:target],
          "--build-number", build_number,
          "--dart-define=API_BASE_URL=https://sevarath.rajendrakhope.com/api/v1",
          "--export-options-plist=#{cfg[:export_options]}"
        )
      end

      ipa_path = Dir.glob(File.join(ipa_dir, "*.ipa")).first
      UI.user_error!("No .ipa found in #{ipa_dir} after building the #{flavor} flavor") unless ipa_path

      upload_to_testflight(
        app_identifier: cfg[:bundle_id],
        ipa: ipa_path,
        skip_waiting_for_build_processing: true
      )
    end
  end

  # No create_app_records lane: produce's ItunesConnect#run (used for App Store Connect app
  # creation, as opposed to the Developer Portal bundle ID registration already done for
  # TestFlight) calls Spaceship::ConnectAPI.login(username, nil, ...) directly, bypassing the
  # same module's own API-key-aware authenticate_connect_api! helper - confirmed by reading
  # fastlane 2.241.0's produce/lib/produce/itunes_connect.rb. With no username configured
  # (nil) this attempts an interactive Apple ID login regardless of the ASC API key already
  # set up in before_all, which would hang or fail in CI. Both app records already exist
  # anyway - upload_to_testflight in ci_release has been succeeding, which requires them - so
  # this lane would have had nothing to do even if it could run safely.

  desc "Local/manual: push App Store listing text for both apps from tools/fastlane/metadata/ios - no binary, no submission"
  lane :upload_metadata do
    {
      "user" => "com.rajendrakhope.sevarath",
      "driver" => "com.rajendrakhope.sevarath.driver"
    }.each do |flavor, bundle_id|
      deliver(
        app_identifier: bundle_id,
        metadata_path: File.join(REPO_ROOT, "tools", "fastlane", "metadata", "ios", flavor),
        skip_binary_upload: true,
        skip_screenshots: true,
        skip_metadata: false,
        force: true,
        submit_for_review: false,
        automatic_release: false
      )
    end
  end
end

platform :android do
  desc "CI: build both flavors' signed release APKs into dist/, named for a GitHub Release"
  lane :build_apk do |options|
    tag_name = options[:tag_name] || ENV.fetch("TAG_NAME")
    dist_dir = File.join(REPO_ROOT, "dist")
    FileUtils.mkdir_p(dist_dir)

    {
      "user" => {
        target: "lib/main_user.dart",
        built_name: "app-user-release.apk",
        dest_name: "SevaRath-#{tag_name}.apk"
      },
      "driver" => {
        target: "lib/main_driver.dart",
        built_name: "app-driver-release.apk",
        dest_name: "SevaRath-Driver-#{tag_name}.apk"
      }
    }.each do |flavor, cfg|
      Dir.chdir(REPO_ROOT) do
        sh(
          "flutter", "build", "apk",
          "--release",
          "--flavor", flavor,
          "-t", cfg[:target],
          "--dart-define=API_BASE_URL=https://sevarath.rajendrakhope.com/api/v1"
        )
      end

      FileUtils.cp(
        File.join(REPO_ROOT, "build", "app", "outputs", "flutter-apk", cfg[:built_name]),
        File.join(dist_dir, cfg[:dest_name])
      )
    end
  end

  desc "CI, upload: build both flavors' signed AABs and push to Google Play (binary + version bump only - no metadata/images, see upload_play_metadata)"
  lane :release_playstore do |options|
    track = options[:track] || ENV["PLAY_TRACK"] || "internal"
    # Same reasoning as iOS's ci_release: Play rejects a reused versionCode on the
    # second upload for a package, and pubspec.yaml's version is static.
    build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s

    {
      "user" => { package_name: "com.rajendrakhope.sevarath", target: "lib/main_user.dart" },
      "driver" => { package_name: "com.rajendrakhope.sevarath.driver", target: "lib/main_driver.dart" }
    }.each do |flavor, cfg|
      Dir.chdir(REPO_ROOT) do
        sh(
          "flutter", "build", "appbundle",
          "--release",
          "--flavor", flavor,
          "-t", cfg[:target],
          "--build-number", build_number,
          "--dart-define=API_BASE_URL=https://sevarath.rajendrakhope.com/api/v1"
        )
      end

      aab_path = Dir.glob(
        File.join(REPO_ROOT, "build", "app", "outputs", "bundle", "#{flavor}Release", "*.aab")
      ).first
      UI.user_error!("No .aab found for the #{flavor} flavor") unless aab_path

      upload_to_play_store(
        package_name: cfg[:package_name],
        aab: aab_path,
        track: track,
        json_key_data: ENV.fetch("PLAY_STORE_JSON_KEY"),
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        # Without this, supply's own metadata_path default - Dir["./fastlane/metadata/android"]
        # + Dir["./metadata"], resolved against this lane's real cwd (tools/fastlane, not
        # tools/ - verified empirically, not assumed) - falls through to "./metadata", i.e.
        # tools/fastlane/metadata/, and treats its "android"/"ios" subdirectories as language
        # codes, aborting the whole upload. This lane never touches changelogs anyway (that's
        # upload_play_metadata's job), so skip it outright rather than pass a metadata_path here.
        skip_upload_changelogs: true
      )
    end
  end

  desc "Local/manual: push Android store-listing text for both apps from tools/fastlane/metadata/android - no binary, no version bump"
  lane :upload_play_metadata do
    {
      "user" => "com.rajendrakhope.sevarath",
      "driver" => "com.rajendrakhope.sevarath.driver"
    }.each do |flavor, package_name|
      upload_to_play_store(
        package_name: package_name,
        # supply's own default track is "production" - this app's first-ever release (Task B3)
        # goes to "internal" instead, which would never have a matching release to attach this
        # metadata push to otherwise ("Could not find release for version code ... to update
        # changelog"). Match whatever track the binary actually lives on.
        track: ENV["PLAY_TRACK"] || "internal",
        json_key_data: ENV.fetch("PLAY_STORE_JSON_KEY"),
        metadata_path: File.join(REPO_ROOT, "tools", "fastlane", "metadata", "android", flavor),
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
  end
end
